# Django Settings
# For development, DEBUG can be True. Set to False in production.
DEBUG=True

# Generate a secure SECRET_KEY in production using: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=your-secret-key-here-generate-for-production

# Comma-separated list of allowed hosts (no spaces after commas)
ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (Neon PostgreSQL)
# Leave empty to use SQLite locally, set to Neon connection string for production
DATABASE_URL=

# Email Configuration (optional)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-email-password

# aws S3 (optional - for static/media storage in production)
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
